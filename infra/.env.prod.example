# Copy this file to infra/.env and fill in real values before
# `docker compose -f docker-compose.prod.yml up -d`.

# A real, random password -- not the local dev default.
POSTGRES_PASSWORD=

# A real, random secret -- e.g. `openssl rand -hex 32`. Never reuse the
# local dev default here.
JWT_SECRET=

# The frontend's own public address, e.g. http://<ELASTIC_IP>
# (comma-separated if more than one). In this deployment shape the browser
# never actually makes a cross-origin request to the backend (nginx proxies
# /v1/* on the same origin the page is served from), so this mostly matters
# if something else ever calls the API directly from a browser context.
CORS_ALLOWED_ORIGINS=http://localhost

# Leave both blank to use the model already baked into the backend image.
# Set both to load from S3 at boot instead -- MODEL_S3_KEY must name one
# specific, already-uploaded artifact, never a "latest.pkl" that gets
# overwritten in place. Name the key just the version (e.g.
# model-artifacts/v1.0.pkl, not model-artifacts/xgboost_v1.0.pkl) -- the
# model name is already prepended automatically when this becomes the
# model_version's version_tag (see seed_model_and_rules.py), so repeating
# it in the key produces a redundant "xgboost-xgboost_v1.0" tag.
MODEL_S3_BUCKET=
MODEL_S3_KEY=
AWS_DEFAULT_REGION=
